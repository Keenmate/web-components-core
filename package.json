{
  "name": "@keenmate/web-components-core",
  "version": "1.0.0-rc16",
  "description": "Reactive input model (converter-driven attribute/property/callback definitions) and the BlissElement base class, shared across KeenMate web components.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./cem": {
      "types": "./dist/cem/index.d.ts",
      "import": "./dist/cem/index.js"
    },
    "./positioning": {
      "types": "./dist/positioning/index.d.ts",
      "import": "./dist/positioning/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "import": "./dist/search/index.js"
    },
    "./menu": {
      "types": "./dist/menu/index.d.ts",
      "import": "./dist/menu/index.js"
    },
    "./component-variables.manifest.json": "./component-variables.manifest.json"
  },
  "files": [
    "dist",
    "component-variables.manifest.json",
    "docs/reactivity-and-batching.md",
    "release-notes"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "build:examples": "vite build --mode examples",
    "preview:examples": "vite preview --mode examples",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "kmwc doctor",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "clean:dist": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.readdirSync('.').filter(f=>f.endsWith('.tgz')).forEach(f=>fs.rmSync(f))\"",
    "prepublishOnly": "npm run clean:dist && npm run build"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "@keenmate/web-components-devkit": "^1.0.0-rc06",
    "@playwright/test": "^1.60.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.7",
    "vitest": "^2.0.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  },
  "kmwc": {
    "title": "Web Components Core",
    "tagline": "The reactive input model + BlissElement base class shared across the KeenMate web components. A library, not a component: each page drives the helpers straight from src/ (no build step), with small demo elements showing the full BlissElement path. Nothing here ships in the published package.",
    "library": false,
    "cssVariables": false,
    "ports": {
      "dev": 15000,
      "image": 15010
    },
    "theme": {
      "accentColor": "#667eea",
      "accentEndColor": "#764ba2"
    },
    "analytics": {
      "plausibleSiteId": "pa-afV_BL6-TQHO6eCUUmxRx"
    },
    "sync": {
      "skippedFiles": [
        "Makefile",
        "CLAUDE.md"
      ]
    }
  }
}
